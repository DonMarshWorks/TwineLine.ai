---
// The PRODUCTION holding page.
//
// This branch (`holding`) exists to be promoted to the Cloudflare Pages
// production deployment. `preview` stays the full working site; this one
// is what twineline.ai serves until there is SaaS marketing worth showing.
//
// Why a holding page at all: the previous live site marketed the SELF-HOST
// product -- "choose your server", a Download button, an installer guide --
// which is no longer what TwineLine is. Wrong marketing is worse than no
// marketing.
//
// DELIBERATELY STANDALONE. It does not use BaseLayout, because that nav
// links to /how-it-works and /guide, which this branch deletes. A holding
// page whose own header 404s is worse than no header.
//
// WHAT MUST SURVIVE ON THIS BRANCH: `src/pages/api/auth/google/**`. The
// backend hardcodes `https://twineline.ai/api/auth/google/refresh`
// (TwineLineFire app/google_oauth.py) and calls `/start` and `/poll`
// (app/api/importers.py) -- that broker carries every Google Takeout
// import. It is live right now: /api/auth/google/start answers 400, not
// 404. If a deploy of this branch ever turns that into a 404, Google
// imports break for every user, and NOT at deploy time -- later, quietly,
// when a token needs refreshing.
//
// After promoting this to production, check that first.
import "../styles/global.css";

const CONSOLE_URL = "https://my.twineline.ai";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="TwineLine.ai turns your photo library into slideshows worth watching. Currently in private beta."
    />
    <!-- Private beta: not something to index yet. -->
    <meta name="robots" content="noindex" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-light.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>TwineLine.ai</title>
  </head>
  <body
    class="min-h-screen antialiased"
    style="font-family: 'Inter', system-ui, sans-serif; color: var(--text-primary); background: var(--bg-deep);"
  >
    <div class="site-bg"></div>

    <main
      class="relative z-10 min-h-screen flex flex-col items-center justify-center px-6 text-center"
    >
      <h1
        class="text-4xl sm:text-5xl font-semibold tracking-tight"
        style="color: var(--text-primary);"
      >
        TwineLine<span class="font-light" style="color: var(--accent);"
          >.ai</span
        >
      </h1>

      <p
        class="mt-6 max-w-md text-lg leading-relaxed"
        style="color: var(--text-secondary);"
      >
        Your photos, turned into slideshows worth actually watching.
      </p>

      <p class="mt-4 max-w-md text-sm" style="color: var(--text-muted);">
        We are rebuilding TwineLine as a hosted service, and it is in private
        beta while we do. There is nothing to sign up for here just yet.
      </p>

      <!-- The reason this page is not merely decorative: existing beta
           users need a way back to their account. Before the sign-in link
           landed, nothing anywhere pointed at the console. -->
      <div class="mt-10 flex flex-col items-center gap-3">
        <a href={CONSOLE_URL} class="btn-accent"> Sign in </a>
        <span class="text-sm" style="color: var(--text-muted);">
          Already have an account?
        </span>
      </div>
    </main>

    <footer class="relative z-10 pb-10 text-center">
      <p class="text-sm" style="color: var(--text-muted);">
        &copy; {new Date().getFullYear()} TwineLine.ai. All rights reserved.
      </p>
    </footer>
  </body>
</html>
