---
import BaseLayout from '../layouts/BaseLayout.astro';

// Set to your R2 video URLs when ready
const heroVideo = 'https://media.twineline.ai/hero-demo.mp4';
const featureVideos = {
  allDevices: 'https://media.twineline.ai/multi-device.mp4',
  transitions: 'https://media.twineline.ai/feature-transitions.mp4',
  videoSupport: '',
  multiDevice: '',
};
---

<BaseLayout title="TwineLine.ai - Relive Your Memories Through Intelligent Slideshows">
  <!-- Hero Section -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-10 sm:pt-16 pb-6 sm:pb-8 text-center">
    <p class="text-xs sm:text-sm font-medium tracking-widest uppercase mb-3 sm:mb-4" style="color: var(--accent);">
      Your memories, beautifully told
    </p>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight" style="color: var(--text-primary);">
      Intelligent slideshows<br class="hidden sm:block" />
      from your <span style="color: var(--accent);">photos &amp; videos</span>
    </h1>
    <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">
      TwineLine creates beautiful, topical slideshows of your memories &mdash; organized by
      people, places, events, and moments that matter. Powered by AI, designed with heart.
    </p>
    <div class="mt-5 sm:mt-6 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
      <a href="/guide" class="btn-accent w-full sm:w-auto text-center">
        Get Started
      </a>
      <a href="/introduction" class="btn-outline w-full sm:w-auto text-center">
        Learn More
      </a>
    </div>
  </section>

  <!-- Hero Video -->
  <section class="mx-auto max-w-2xl px-4 sm:px-6 pb-12 sm:pb-16">
    <div class="hero-video-wrapper">
      {heroVideo ? (
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster=""
        >
          <source src={heroVideo} type="video/mp4" />
        </video>
      ) : (
        <div class="hero-video-placeholder">
          <svg class="w-12 h-12 sm:w-16 sm:h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" style="color: var(--text-muted);">
            <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
          <span class="text-sm" style="color: var(--text-muted);">Hero video coming soon</span>
        </div>
      )}
    </div>
  </section>

  <!-- Feature Cards -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="glass p-6 sm:p-8">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5 text-xl" style="background: var(--accent-glow); color: var(--accent);">
          &#9733;
        </div>
        <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary);">Smart.</h3>
        <p style="color: var(--text-secondary); font-size: 0.925rem; line-height: 1.6;">
          Set rules like &ldquo;travel on weekends&rdquo; or &ldquo;family on birthdays.&rdquo;
          TwineLine creates a fresh slideshow every day &mdash; different every time, no effort required.
        </p>
      </div>

      <div class="glass p-6 sm:p-8">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5 text-xl" style="background: var(--accent-glow); color: var(--accent);">
          &#127912;
        </div>
        <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary);">Beautiful.</h3>
        <p style="color: var(--text-secondary); font-size: 0.925rem; line-height: 1.6;">
          Smooth Ken Burns animation, cinematic transitions, and video clips bring your photos to life
          across every screen &mdash; Fire TV, computers, tablets, and phones.
        </p>
      </div>

      <div class="glass p-6 sm:p-8 sm:col-span-2 lg:col-span-1">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5 text-xl" style="background: var(--accent-glow); color: var(--accent);">
          &#128274;
        </div>
        <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary);">Free.</h3>
        <p style="color: var(--text-secondary); font-size: 0.925rem; line-height: 1.6;">
          No subscription, no account, no data collection. Install on your own computer, or choose
          affordable hosting for web access without managing your own server.
        </p>
      </div>
    </div>
  </section>

  <!-- Feature Showcase with Video Clips -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-20">
    <div class="text-center mb-10 sm:mb-16">
      <h2 class="text-2xl sm:text-3xl font-bold" style="color: var(--text-primary);">See it in action</h2>
      <p class="mt-3" style="color: var(--text-secondary);">Every detail designed for a beautiful viewing experience</p>
    </div>

    <!-- Feature 1: All Devices -->
    <div class="grid gap-8 lg:gap-12 lg:grid-cols-2 items-center mb-16 sm:mb-24">
      <div class="feature-video-wrapper order-2 lg:order-1">
        {featureVideos.allDevices ? (
          <video autoplay muted loop playsinline preload="metadata">
            <source src={featureVideos.allDevices} type="video/mp4" />
          </video>
        ) : (
          <div class="w-full h-full flex items-center justify-center" style="color: var(--text-muted);">
            <span class="text-sm">All devices clip</span>
          </div>
        )}
      </div>
      <div class="order-1 lg:order-2">
        <div class="inline-block text-xs font-medium uppercase tracking-widest px-3 py-1 rounded-full mb-4" style="background: var(--accent-glow); color: var(--accent);">
          All Devices
        </div>
        <h3 class="text-xl sm:text-2xl font-bold mb-3" style="color: var(--text-primary);">
          One slideshow, many screens
        </h3>
        <p style="color: var(--text-secondary); line-height: 1.7;">
          Your slideshow can play on every connected screen in the house. Control it from any
          device &mdash; even a FireTV remote. With cloud hosting, family across the country can
          watch together, as if they were in the same room.
        </p>
      </div>
    </div>

    <!-- Feature 2: Multiple Topics -->
    <div class="grid gap-8 lg:gap-12 lg:grid-cols-2 items-center mb-16 sm:mb-24">
      <div class="order-1">
        <div class="inline-block text-xs font-medium uppercase tracking-widest px-3 py-1 rounded-full mb-4" style="background: var(--accent-glow); color: var(--accent);">
          Multiple Topics
        </div>
        <h3 class="text-xl sm:text-2xl font-bold mb-3" style="color: var(--text-primary);">
          Mix and match your memories
        </h3>
        <p style="color: var(--text-secondary); line-height: 1.7;">
          A single-topic slideshow is great, but life isn&rsquo;t one-dimensional.
          Mix travel, family, holidays, and everyday moments into a single slideshow
          that reflects the full richness of your memories.
        </p>
      </div>
      <div class="feature-video-wrapper order-2">
        {featureVideos.transitions ? (
          <video autoplay muted loop playsinline preload="metadata">
            <source src={featureVideos.transitions} type="video/mp4" />
          </video>
        ) : (
          <div class="w-full h-full flex items-center justify-center" style="color: var(--text-muted);">
            <span class="text-sm">Multiple topics clip</span>
          </div>
        )}
      </div>
    </div>

    <!-- Feature 3: Connections -->
    <div class="grid gap-8 lg:gap-12 lg:grid-cols-2 items-center mb-16 sm:mb-24">
      <div class="feature-video-wrapper order-2 lg:order-1">
        <img src="/connections-feature.svg" alt="Supported photo sources: OneDrive, Local Files, Pixabay, Google Photos, iCloud Photos" width="854" height="480" loading="lazy" />
      </div>
      <div class="order-1 lg:order-2">
        <div class="inline-block text-xs font-medium uppercase tracking-widest px-3 py-1 rounded-full mb-4" style="background: var(--accent-glow); color: var(--accent);">
          Connections
        </div>
        <h3 class="text-xl sm:text-2xl font-bold mb-3" style="color: var(--text-primary);">
          One slideshow, many sources
        </h3>
        <p style="color: var(--text-secondary); line-height: 1.7;">
          Pull from OneDrive, Pixabay, or your local files &mdash; all in the same slideshow.
          TwineLine supports migration from Google Photos or iCloud Photos.
          We&rsquo;re also adding museum collections and public archives, so your memories
          can be enriched with beautiful images from around the world.
        </p>
      </div>
    </div>

    <!-- Feature 4: Multi-Device -->
    <div class="grid gap-8 lg:gap-12 lg:grid-cols-2 items-center">
      <div class="order-1">
        <div class="inline-block text-xs font-medium uppercase tracking-widest px-3 py-1 rounded-full mb-4" style="background: var(--accent-glow); color: var(--accent);">
          Your AI
        </div>
        <h3 class="text-xl sm:text-2xl font-bold mb-3" style="color: var(--text-primary);">
          Photo intelligence you own
        </h3>
        <p style="color: var(--text-secondary); line-height: 1.7;">
          TwineLine uses AI to understand the people, places, and moments in your photos.
          Unlike Google, Apple, or Microsoft, we don&rsquo;t lock these insights away or change the rules.
          Your photo intelligence belongs to you, is controlled by you, and isn&rsquo;t accessible to anyone but you.
        </p>
      </div>
      <div class="feature-video-wrapper order-2">
        <img src="https://media.twineline.ai/ai-feature-v2.webp" alt="AI-powered photo intelligence" width="854" height="466" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 sm:py-16">
    <div class="text-center mb-10 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold" style="color: var(--text-primary);">How it works</h2>
      <p class="mt-3" style="color: var(--text-secondary);">Three simple steps to relive your favorite moments</p>
    </div>
    <div class="grid gap-8 sm:grid-cols-3">
      <div class="text-center">
        <div class="w-12 h-12 rounded-full mx-auto flex items-center justify-center text-lg font-bold mb-4" style="background: #c49345; color: #fff;">
          1
        </div>
        <h3 class="font-semibold mb-2" style="color: var(--text-primary);">Point to your photos</h3>
        <p class="text-sm" style="color: var(--text-secondary);">
          Connect TwineLine to your photo library, wherever it lives.
        </p>
      </div>
      <div class="text-center">
        <div class="w-12 h-12 rounded-full mx-auto flex items-center justify-center text-lg font-bold mb-4" style="background: #c49345; color: #fff;">
          2
        </div>
        <h3 class="font-semibold mb-2" style="color: var(--text-primary);">Choose your topics</h3>
        <p class="text-sm" style="color: var(--text-secondary);">
          Select people, places, events, or time periods you want to revisit.
        </p>
      </div>
      <div class="text-center">
        <div class="w-12 h-12 rounded-full mx-auto flex items-center justify-center text-lg font-bold mb-4" style="background: #c49345; color: #fff;">
          3
        </div>
        <h3 class="font-semibold mb-2" style="color: var(--text-primary);">Sit back and enjoy</h3>
        <p class="text-sm" style="color: var(--text-secondary);">
          A director creates a beautiful, dynamic slideshow &mdash; different every time.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-20 text-center">
    <div class="glass p-8 sm:p-12">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4" style="color: var(--text-primary);">Ready to get started?</h2>
      <p class="mb-8" style="color: var(--text-secondary);">
        Use our interactive guide to configure TwineLine for your setup.
      </p>
      <a href="/guide" class="btn-accent inline-block">
        Launch Setup Guide
      </a>
    </div>
  </section>
</BaseLayout>
