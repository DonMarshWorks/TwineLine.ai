---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Download TwineLine"
  description="Install TwineLine on your computer and start reliving your memories through beautiful slideshows."
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-12 sm:py-20">
    <!-- Hero -->
    <section class="text-center mb-16">
      <img src="/logo.svg" alt="TwineLine" class="h-32 sm:h-40 mx-auto mb-6" />
      <p class="text-lg sm:text-xl mb-4" style="color: var(--text-secondary);">
        Turn your photos into a beautiful slideshow
      </p>
      <div
        id="version-badge"
        class="inline-block px-3 py-1 rounded-full text-xs font-medium"
        style="background: var(--glass-bg); border: 1px solid var(--glass-border); color: var(--text-muted);"
      >
        Loading version...
      </div>
    </section>

    <!-- Quick install -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Quick install</h2>

      <!-- Platform tabs -->
      <div
        class="flex gap-1 mb-4 p-1 rounded-xl w-fit"
        style="background: var(--glass-bg); border: 1px solid var(--glass-border);"
      >
        <button
          class="platform-tab active px-4 py-2 rounded-lg text-sm font-medium transition-all"
          data-platform="windows">Windows</button
        >
        <button
          class="platform-tab px-4 py-2 rounded-lg text-sm font-medium transition-all"
          data-platform="macos">macOS</button
        >
        <button
          class="platform-tab px-4 py-2 rounded-lg text-sm font-medium transition-all"
          data-platform="linux">Linux</button
        >
      </div>

      <!-- Windows instructions -->
      <div class="platform-content glass p-6" data-platform="windows">
        <ol class="space-y-4" style="color: var(--text-secondary);">
          <li class="flex gap-3">
            <span
              class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold"
              style="background: var(--accent); color: #fff;">1</span
            >
            <div>
              <p>Open PowerShell and paste this command:</p>
              <div class="mt-2 relative group">
                <pre
                  class="rounded-lg px-4 py-3 text-sm overflow-x-auto"
                  style="background: rgba(0,0,0,0.4); border: 1px solid var(--glass-border); color: var(--text-primary);"><code>irm https://twineline.ai/install.ps1 | iex</code></pre>
                <button
                  class="copy-btn absolute top-2 right-2 px-2 py-1 rounded text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                  style="background: var(--glass-bg); border: 1px solid var(--glass-border); color: var(--text-muted);"
                  data-copy="irm https://twineline.ai/install.ps1 | iex"
                  >Copy</button
                >
              </div>
            </div>
          </li>
          <li class="flex gap-3">
            <span
              class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold"
              style="background: var(--accent); color: #fff;">2</span
            >
            <p>
              Open <a
                href="http://localhost:8080"
                class="underline"
                style="color: var(--accent);">http://localhost:8080</a
              > in your browser
            </p>
          </li>
        </ol>
      </div>

      <!-- macOS instructions -->
      <div class="platform-content glass p-6 hidden" data-platform="macos">
        <ol class="space-y-4" style="color: var(--text-secondary);">
          <li class="flex gap-3">
            <span
              class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold"
              style="background: var(--accent); color: #fff;">1</span
            >
            <div>
              <p>Open Terminal and paste this command:</p>
              <div class="mt-2 relative group">
                <pre
                  class="rounded-lg px-4 py-3 text-sm overflow-x-auto"
                  style="background: rgba(0,0,0,0.4); border: 1px solid var(--glass-border); color: var(--text-primary);"><code>curl -fsSL https://twineline.ai/install.sh | bash</code></pre>
                <button
                  class="copy-btn absolute top-2 right-2 px-2 py-1 rounded text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                  style="background: var(--glass-bg); border: 1px solid var(--glass-border); color: var(--text-muted);"
                  data-copy="curl -fsSL https://twineline.ai/install.sh | bash"
                  >Copy</button
                >
              </div>
            </div>
          </li>
          <li class="flex gap-3">
            <span
              class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold"
              style="background: var(--accent); color: #fff;">2</span
            >
            <p>
              Open <a
                href="http://localhost:8080"
                class="underline"
                style="color: var(--accent);">http://localhost:8080</a
              > in your browser
            </p>
          </li>
        </ol>
      </div>

      <!-- Linux instructions -->
      <div class="platform-content glass p-6 hidden" data-platform="linux">
        <ol class="space-y-4" style="color: var(--text-secondary);">
          <li class="flex gap-3">
            <span
              class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold"
              style="background: var(--accent); color: #fff;">1</span
            >
            <div>
              <p>Open a terminal and paste this command:</p>
              <div class="mt-2 relative group">
                <pre
                  class="rounded-lg px-4 py-3 text-sm overflow-x-auto"
                  style="background: rgba(0,0,0,0.4); border: 1px solid var(--glass-border); color: var(--text-primary);"><code>curl -fsSL https://twineline.ai/install.sh | bash</code></pre>
                <button
                  class="copy-btn absolute top-2 right-2 px-2 py-1 rounded text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                  style="background: var(--glass-bg); border: 1px solid var(--glass-border); color: var(--text-muted);"
                  data-copy="curl -fsSL https://twineline.ai/install.sh | bash"
                  >Copy</button
                >
              </div>
            </div>
          </li>
          <li class="flex gap-3">
            <span
              class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold"
              style="background: var(--accent); color: #fff;">2</span
            >
            <p>
              Open <a
                href="http://localhost:8080"
                class="underline"
                style="color: var(--accent);">http://localhost:8080</a
              > in your browser
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- What you'll need -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">What you'll need</h2>
      <div class="glass p-6">
        <ul class="space-y-4" style="color: var(--text-secondary);">
          <li class="flex gap-3 items-start">
            <svg
              class="w-5 h-5 shrink-0 mt-0.5"
              style="color: var(--accent);"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>A computer that stays on (this is your TwineLine server)</span
            >
          </li>
          <li class="flex gap-3 items-start">
            <svg
              class="w-5 h-5 shrink-0 mt-0.5"
              style="color: var(--accent);"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span
              >A TV or display connected to a Fire TV stick, Chromecast, or
              browser</span
            >
          </li>
          <li class="flex gap-3 items-start">
            <svg
              class="w-5 h-5 shrink-0 mt-0.5"
              style="color: var(--accent);"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            <span
              >Your photos (local folders, OneDrive, Google Photos, or iCloud)</span
            >
          </li>
        </ul>
      </div>
    </section>

    <!-- Release history -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-6">Release history</h2>
      <div id="releases-list" class="space-y-3">
        <div class="glass p-6 text-center" style="color: var(--text-muted);">
          Loading releases...
        </div>
      </div>
    </section>

    <!-- Automatic updates -->
    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">Automatic updates</h2>
      <p style="color: var(--text-secondary);">
        TwineLine checks for updates automatically and notifies you when a new
        version is available. You can update with one click from the Settings
        menu.
      </p>
    </section>
  </div>

  <style>
    .platform-tab {
      color: var(--text-muted);
      cursor: pointer;
    }
    .platform-tab:hover {
      color: var(--text-primary);
    }
    .platform-tab.active {
      background: var(--accent);
      color: #fff;
    }
    .release-card {
      transition: border-color 0.2s ease;
    }
    .release-card:hover {
      border-color: var(--glass-border-hover);
    }
    .release-latest {
      border-color: var(--accent) !important;
    }
  </style>

  <script is:inline>
    // ── Platform tabs ──────────────────────────────────────────────────────
    const tabs = document.querySelectorAll(".platform-tab");
    const panels = document.querySelectorAll(".platform-content");

    // Auto-detect platform
    const ua = navigator.userAgent.toLowerCase();
    let detectedPlatform = "linux";
    if (ua.includes("win")) detectedPlatform = "windows";
    else if (ua.includes("mac")) detectedPlatform = "macos";

    function switchPlatform(platform) {
      tabs.forEach((t) =>
        t.classList.toggle("active", t.dataset.platform === platform),
      );
      panels.forEach((p) =>
        p.classList.toggle("hidden", p.dataset.platform !== platform),
      );
    }

    switchPlatform(detectedPlatform);

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => switchPlatform(tab.dataset.platform));
    });

    // ── Copy buttons ───────────────────────────────────────────────────────
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy);
          btn.textContent = "Copied!";
        } catch {
          btn.textContent = "Failed";
        }
        setTimeout(() => (btn.textContent = "Copy"), 2000);
      });
    });

    // ── Fetch manifest ─────────────────────────────────────────────────────
    function buildReleaseCard(release, isLatest) {
      const card = document.createElement("div");
      card.className =
        "glass release-card p-5" + (isLatest ? " release-latest" : "");

      const row = document.createElement("div");
      row.className =
        "flex flex-col sm:flex-row sm:items-center justify-between gap-3";

      const info = document.createElement("div");
      const header = document.createElement("div");
      header.className = "flex items-center gap-3 mb-1";

      const tag = document.createElement("span");
      tag.className = "font-semibold";
      tag.textContent = release.tag;
      header.appendChild(tag);

      if (isLatest) {
        const badge = document.createElement("span");
        badge.className = "px-2 py-0.5 rounded-full text-xs font-medium";
        badge.style.cssText = "background: var(--accent); color: #fff;";
        badge.textContent = "Latest";
        header.appendChild(badge);
      }

      if (release.date) {
        const dateEl = document.createElement("span");
        dateEl.className = "text-xs";
        dateEl.style.color = "var(--text-muted)";
        dateEl.textContent = new Date(release.date).toLocaleDateString(
          "en-US",
          {
            year: "numeric",
            month: "long",
            day: "numeric",
          },
        );
        header.appendChild(dateEl);
      }

      info.appendChild(header);

      if (release.notes) {
        const notes = document.createElement("p");
        notes.className = "text-sm mt-1";
        notes.style.color = "var(--text-secondary)";
        notes.textContent = release.notes;
        info.appendChild(notes);
      }

      row.appendChild(info);

      try {
        const u = release.bundle_url
          ? new URL(release.bundle_url, location.origin)
          : null;
        if (
          u &&
          u.origin === location.origin &&
          u.pathname.startsWith("/releases/")
        ) {
          const link = document.createElement("a");
          link.href = u.href;
          link.className = "btn-outline shrink-0 text-center";
          link.download = "";
          link.textContent = "Download";
          row.appendChild(link);
        }
      } catch {}

      card.appendChild(row);
      return card;
    }

    (async () => {
      const badge = document.getElementById("version-badge");
      const container = document.getElementById("releases-list");
      if (!badge || !container) return;

      try {
        const res = await fetch("/releases/manifest.json");
        if (!res.ok) throw new Error("Failed to fetch manifest");
        const manifest = await res.json();

        if (
          !manifest ||
          typeof manifest.latest !== "string" ||
          !Array.isArray(manifest.releases)
        ) {
          throw new Error("Invalid manifest format");
        }

        badge.textContent = "v" + manifest.latest.replace(/^v/, "");

        if (manifest.releases.length === 0) {
          container.textContent = "";
          const empty = document.createElement("div");
          empty.className = "glass p-6 text-center";
          empty.style.color = "var(--text-muted)";
          empty.textContent = "No releases available yet.";
          container.appendChild(empty);
          return;
        }

        container.textContent = "";
        manifest.releases.forEach(function (release) {
          container.appendChild(
            buildReleaseCard(release, release.tag === manifest.latest),
          );
        });
      } catch (e) {
        badge.textContent = "TwineLine";
        container.textContent = "";
        const err = document.createElement("div");
        err.className = "glass p-6 text-center";
        err.style.color = "var(--text-muted)";
        err.textContent = "Could not load releases. Please try again later.";
        container.appendChild(err);
      }
    })();
  </script>
</BaseLayout>
