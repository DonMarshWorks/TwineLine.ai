  <script is:inline>
    window.addEventListener("DOMContentLoaded", function () {
      var videos = document.querySelectorAll("video");
      var hero = document.getElementById("hiw-hero-video");
      var heroOffset = 1;

      // Force all videos to play immediately
      videos.forEach(function (vid) {
        vid.play().catch(function () {});
      });

      // Once hero can play, set its offset then sync all others to time 0
      if (hero) {
        hero.addEventListener("canplay", function h() {
          hero.currentTime = heroOffset;
          hero.removeEventListener("canplay", h);
        });
      }

      // If a video gets paused (e.g. mobile offscreen optimization), restart it on visibility
      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) {
          videos.forEach(function (vid) {
            if (vid.paused) vid.play().catch(function () {});
          });
        }
      });
    });
  </script>
