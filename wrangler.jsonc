{
	"main": "dist/_worker.js/index.js",
	"name": "twineline-ai",
  "compatibility_date": "2026-02-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"r2_buckets": [
		{
			"binding": "RELEASES",
			"bucket_name": "twineline-releases"
		}
	],
	"observability": {
    "enabled": true
  }
}